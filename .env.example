# Copy to .env and fill in real values once you have a Supabase project.
# Never commit .env — it's gitignored.

# From your Supabase project's Settings -> API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# From your Paystack dashboard, once you're ready to wire up real payments.
# Set this as a Supabase secret (not just here) before deploying the
# paystack-webhook function:
#   supabase secrets set PAYSTACK_SECRET_KEY=sk_...
PAYSTACK_SECRET_KEY=
